#include <stdio.h>

/* 1. Number of digits */
int nb_digits(int n) {
    if (n < 10)
        return 1;
    return 1 + nb_digits(n / 10);
}

int power(int base, int exponent) {
    if (exponent == 0)
        return 1;
    return base * power(base, exponent - 1);
}

int recup_digit(int n, int len, int pos) {
    if (pos > len)
        return 0;

    int digit = (n / power(10, len - pos)) % 10;   // digit at position pos
    return power(digit, pos) + recup_digit(n, len, pos + 1);
}

int is_disarium(int n) {
    return recup_digit(n, nb_digits(n), 1) == n;
}

int main(void) {
    int tests[] = {135, 89, 175, 123};
    for (int i = 0; i < 4; i++)
        printf("%d -> %s\n", tests[i],
               is_disarium(tests[i]) ? "disarium" : "not disarium");
    return 0;
}
